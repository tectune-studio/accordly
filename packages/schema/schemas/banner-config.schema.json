{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BannerConfig",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": ["necessary", "analytics", "marketing", "functional"]
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "cookiePatterns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": ["id", "name", "cookiePatterns"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "services"],
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 4,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "necessary"
              }
            },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "analytics"
              }
            },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "marketing"
              }
            },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "id": {
                "const": "functional"
              }
            },
            "required": ["id"]
          }
        }
      ]
    },
    "scriptRules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": ["necessary", "analytics", "marketing", "functional"]
          },
          "match": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["exact", "prefix"]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["kind", "value"],
            "additionalProperties": false
          }
        },
        "required": ["category", "match"],
        "additionalProperties": false
      }
    },
    "googleSignals": {
      "type": "object",
      "properties": {
        "ad_storage": {
          "type": "string",
          "enum": ["necessary", "analytics", "marketing", "functional"]
        },
        "analytics_storage": {
          "type": "string",
          "enum": ["necessary", "analytics", "marketing", "functional"]
        },
        "ad_user_data": {
          "type": "string",
          "enum": ["necessary", "analytics", "marketing", "functional"]
        },
        "ad_personalization": {
          "type": "string",
          "enum": ["necessary", "analytics", "marketing", "functional"]
        }
      },
      "required": ["ad_storage", "analytics_storage", "ad_user_data", "ad_personalization"],
      "additionalProperties": false
    },
    "regionRules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "countries": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:[A-Z]{2}|\\*)$"
            }
          },
          "mode": {
            "type": "string",
            "enum": ["opt-in", "opt-out"]
          },
          "respectGpc": {
            "type": "boolean"
          },
          "gpcCategories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["necessary", "analytics", "marketing", "functional"]
            }
          }
        },
        "required": ["countries", "mode", "respectGpc", "gpcCategories"],
        "additionalProperties": false
      }
    },
    "texts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "acceptAll": {
            "type": "string",
            "minLength": 1
          },
          "rejectAll": {
            "type": "string",
            "minLength": 1
          },
          "save": {
            "type": "string",
            "minLength": 1
          },
          "preferences": {
            "type": "string",
            "minLength": 1
          },
          "privacyUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "title",
          "description",
          "acceptAll",
          "rejectAll",
          "save",
          "preferences",
          "privacyUrl"
        ],
        "additionalProperties": false
      }
    },
    "defaultLanguage": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "fontFamily": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "string",
          "enum": ["bottom", "top", "center"]
        }
      },
      "required": ["background", "foreground", "accent", "fontFamily", "position"],
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "properties": {
        "cookieLifetimeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 395
        },
        "repromptOnConfigChange": {
          "type": "boolean"
        },
        "consentWall": {
          "type": "boolean"
        }
      },
      "required": ["cookieLifetimeDays", "repromptOnConfigChange", "consentWall"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "configHash",
    "categories",
    "scriptRules",
    "googleSignals",
    "regionRules",
    "texts",
    "defaultLanguage",
    "theme",
    "behavior"
  ],
  "additionalProperties": false
}
