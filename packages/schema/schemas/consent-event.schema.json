{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConsentEvent",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "subjectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{16,128}$"
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "action": {
      "type": "string",
      "enum": ["accept_all", "reject_all", "custom", "update", "withdraw"]
    },
    "choices": {
      "type": "object",
      "properties": {
        "analytics": {
          "type": "boolean"
        },
        "marketing": {
          "type": "boolean"
        },
        "functional": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-zA-Z]{2,8}(?:-[a-zA-Z0-9]{1,8})*$"
    },
    "gpcDetected": {
      "type": "boolean"
    },
    "clientTime": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "projectId",
    "subjectId",
    "configHash",
    "action",
    "choices",
    "language",
    "gpcDetected",
    "clientTime"
  ],
  "additionalProperties": false
}
