{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "accordly-delivery",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "consent.tectune.in", "custom_domain": true }],
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "r2_buckets": [
    { "binding": "CONFIGS", "bucket_name": "consent-config-tectune" },
    { "binding": "RECEIPTS", "bucket_name": "consent-receipts-tectune" },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f7229a57a0f74f15b713d0c40a6943e6",
    },
  ],
  "queues": {
    "producers": [{ "binding": "CONSENT_QUEUE", "queue": "accordly-decisions" }],
    "consumers": [
      {
        "queue": "accordly-decisions",
        "max_batch_size": 50,
        "max_retries": 5,
        "dead_letter_queue": "accordly-decisions-dlq",
      },
    ],
  },
  "ratelimits": [
    { "name": "INGEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
  "observability": { "enabled": true },
}
