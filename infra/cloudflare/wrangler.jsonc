{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "consentkit-delivery",
  "account_id": "5a59ad39af377a19e369652ac5ac6770",
  "workers_dev": false,
  "routes": [{ "pattern": "consent.tectune.in", "custom_domain": true }],
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "r2_buckets": [
    { "binding": "CONFIGS", "bucket_name": "consent-config-tectune" },
    { "binding": "RECEIPTS", "bucket_name": "consent-receipts-tectune" },
  ],
  "queues": {
    "producers": [{ "binding": "CONSENT_QUEUE", "queue": "consentkit-decisions" }],
    "consumers": [
      {
        "queue": "consentkit-decisions",
        "max_batch_size": 50,
        "max_retries": 5,
        "dead_letter_queue": "consentkit-decisions-dlq",
      },
    ],
  },
  "ratelimits": [
    { "name": "INGEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
  ],
  "observability": { "enabled": true },
}
