# Non-secret deployment settings. Load into the dashboard environment.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
ACCORDLY_DELIVERY_ORIGIN=
R2_BUCKET=
# RECEIPTS Worker binding:
# Add CLOUDFLARE_API_TOKEN and ACCORDLY_PUBLISH_SECRET through secret settings.
# Deployment additionally needs a Workers/R2/Queues/Routes operator token.

# Planned static delivery migration; these placeholders do not enable it.
# Dashboard/Vercel server-only R2 S3 credentials and endpoint:
ACCORDLY_R2_ACCESS_KEY_ID=dummy_r2_access_key_replace_me
ACCORDLY_R2_SECRET_ACCESS_KEY=dummy_r2_secret_key_replace_me
ACCORDLY_R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
ACCORDLY_R2_CONFIG_BUCKET=consent-config-tectune
ACCORDLY_CDN_ORIGIN=https://cdn.accordly.tectune.in
ACCORDLY_INGEST_URL=https://cdn.accordly.tectune.in/ingest
# Private RECEIPTS bucket for fallback objects; never attach the public CDN to it.
ACCORDLY_R2_RECEIPTS_BUCKET=consent-receipts-tectune
# Deployment input: copy into wrangler hyperdrive[].id, binding HYPERDRIVE.
# This is a resource ID, not a password; env files alone do not create bindings.
CLOUDFLARE_HYPERDRIVE_ID=dummy_hyperdrive_id_replace_me
# Configure Hyperdrive's origin with a restricted ingestion database user.
# Do not give it SUPABASE_DB_URL (the migration-owner credential).
