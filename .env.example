# Demo mode makes no third-party requests. Never use demo authentication publicly.
ACCORDLY_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dummy_replace_me
CLERK_SECRET_KEY=sk_test_dummy_replace_me
STRIPE_SECRET_KEY=sk_test_dummy_replace_me
STRIPE_WEBHOOK_SECRET=whsec_dummy_replace_me
STRIPE_PRICE_STARTER=price_dummy_starter
STRIPE_PRICE_GROWTH=price_dummy_growth
DATABASE_URL=postgresql://dummy:dummy@localhost:5432/accordly
CLOUDFLARE_ACCOUNT_ID=dummy_replace_me
CLOUDFLARE_API_TOKEN=dummy_replace_me
