# ---------APP--------------
ACCORDLY_MODE=demo # live for production
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ---------Clerk------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# ---------Database---------
# PostgreSQL owner connection: migration/provisioning only
DATABASE_URL=
# Generated by scripts/database/provision.mjs
ACCORDLY_DATABASE_URL=
ACCORDLY_MAINTENANCE_DATABASE_URL=
# ---------Stripe-------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
# ---------CF---------
ACCORDLY_R2_ACCESS_KEY_ID=
ACCORDLY_R2_SECRET_ACCESS_KEY=
ACCORDLY_R2_ENDPOINT=
ACCORDLY_R2_CONFIG_BUCKET=
ACCORDLY_R2_RECEIPTS_BUCKET=
ACCORDLY_CDN_ORIGIN=
ACCORDLY_INGEST_URL=
CLOUDFLARE_HYPERDRIVE_ID=
# Account Wide
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
ACCORDLY_DELIVERY_ORIGIN=
# Dashboard token: Cache Purge permission for the selected zone
CLOUDFLARE_API_TOKEN=
# Operator token: deployment only
CLOUDFLARE_DEPLOY_API_TOKEN=
# Same value as the Worker's PUBLISH_SECRET ( openssl rand -hex 32)
ACCORDLY_PUBLISH_SECRET=
# Resource names; actual Worker bindings are configured in wrangler.jsonc
R2_RECEIPTS_BUCKET=
R2_BUCKET=

# ---------Additional---------
CONSENTKIT_DATA_DIR=apps\.data
PLAYWRIGHT_CHROMIUM_PATH=C:\pw-browsers\chromium-1248\chrome-win64\chrome.exe
PLAYWRIGHT_BROWSERS_PATH=C:\pw-browsers
