# Demo mode makes no third-party requests. Never use demo authentication publicly.
ACCORDLY_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_dummy_replace_me
CLERK_SECRET_KEY=sk_test_dummy_replace_me
STRIPE_SECRET_KEY=sk_test_dummy_replace_me
STRIPE_WEBHOOK_SECRET=whsec_dummy_replace_me
STRIPE_PRICE_STARTER=price_dummy_starter
STRIPE_PRICE_GROWTH=price_dummy_growth
DATABASE_URL=postgresql://dummy:dummy@localhost:5432/accordly
CLOUDFLARE_ACCOUNT_ID=dummy_replace_me
CLOUDFLARE_API_TOKEN=dummy_replace_me
R2_BUCKET=accordly-configs
CLOUDFLARE_ZONE_ID=
ACCORDLY_DELIVERY_ORIGIN=https://consent.example.com
# Same random 32+ character value as the delivery Worker's PUBLISH_SECRET secret.
ACCORDLY_PUBLISH_SECRET=

# Live Accordly: set ACCORDLY_MODE=live and supply real values securely.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Migration/provisioning only; never use the owner URL in the application runtime.
SUPABASE_DB_URL=
ACCORDLY_DATABASE_URL=
ACCORDLY_MAINTENANCE_DATABASE_URL=

# Planned static delivery migration (not wired into publishing/ingest yet).
# Vercel server-only settings. Never prefix credentials with NEXT_PUBLIC_.
# Create an R2 API token scoped to the public config/SDK bucket.
ACCORDLY_R2_ACCESS_KEY_ID=dummy_r2_access_key_replace_me
ACCORDLY_R2_SECRET_ACCESS_KEY=dummy_r2_secret_key_replace_me
ACCORDLY_R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
ACCORDLY_R2_CONFIG_BUCKET=consent-config-tectune
# Attach this hostname to the public R2 bucket before enabling static delivery.
ACCORDLY_CDN_ORIGIN=https://cdn.accordly.tectune.in
# Planned ingest URL; current delivery routes remain in use until cutover.
ACCORDLY_INGEST_URL=https://cdn.accordly.tectune.in/ingest
# Cloudflare deployment input only, not a Vercel runtime secret.
# Copy the real ID into wrangler's hyperdrive entry with binding HYPERDRIVE.
# Wrangler does not automatically interpolate this environment variable.
CLOUDFLARE_HYPERDRIVE_ID=dummy_hyperdrive_id_replace_me
