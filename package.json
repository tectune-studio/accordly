{
  "name": "accordly",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @accordly/dashboard",
    "build": "npm run build -w @accordly/dashboard",
    "start": "npm run start -w @accordly/dashboard",
    "test": "node --test packages/consent-core/test/*.test.mjs apps/dashboard/test/*.test.mjs infra/cloudflare/test/*.test.mjs packages/schema/test/*.test.mjs",
    "typecheck": "tsc --noEmit -p apps/dashboard && tsc --noEmit -p packages/consent-react && tsc --noEmit -p infra/cloudflare",
    "check": "npm run test && npm run typecheck && npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema:generate": "npm run generate -w @accordly/schema",
    "dev:marketing": "npm run dev -w @accordly/marketing",
    "build:marketing": "npm run build -w @accordly/marketing",
    "start:marketing": "npm run start -w @accordly/marketing"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25"
  }
}
